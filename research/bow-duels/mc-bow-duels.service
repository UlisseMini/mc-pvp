[Unit]
Description=Minecraft Bow Duel policy league
After=local-fs.target

[Service]
User=uli
WorkingDirectory=/home/uli/mc-bow-duels/fixed-001
ExecStart=/home/uli/mc-sumo-league/venv/bin/python -u competition.py --out /home/uli/mc-bow-duels/run-006-fixed
Restart=on-failure
RestartSec=30
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
Environment=BOW_GEOMETRY_LIB=/home/uli/mc-bow-duels/fixed-001/build/libbow_geometry.so

[Install]
WantedBy=multi-user.target
